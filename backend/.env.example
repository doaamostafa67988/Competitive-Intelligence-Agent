# LLM_PROVIDER selects which client the backend builds: "groq" (free tier)
# or "openai" (paid). You only need to fill in the key for whichever one
# you pick — the other can stay blank.
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Match LLM_MODEL to your provider, e.g.:
#   groq:   llama-3.3-70b-versatile, llama-3.1-8b-instant
#   openai: gpt-4o-mini, gpt-4o
LLM_MODEL=llama-3.3-70b-versatile

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=announcements
QDRANT_API_KEY=

POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/competitive_intel

MCP_SERVER_URL=http://mcp-server:8765/mcp
NEWS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Social listening (Twitter/X, LinkedIn, Reddit site-search) -> https://serpapi.com/manage-api-key
SERPAPI_KEY=

TRACKED_COMPETITORS=[]
WEEKLY_RUN_CRON=0 8 * * MON
ALERT_POLL_MINUTES=30
MIN_SOURCES_TO_CONFIRM=2
